SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=avocent_healthcare
DB_USER=avocent
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# Email / SMTP (leave blank to disable email sending)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@avocent.health

# Frontend base URL, used to build links embedded in outgoing emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=86400

API_ENCRYPTION_ENABLED=false
API_ENCRYPTION_ENFORCE=false
API_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info
