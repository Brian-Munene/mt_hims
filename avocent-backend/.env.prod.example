SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=api.example.com,web

# Reverse proxy (Caddy) domains
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# Frontend build-time/runtime config (staging/prod default to localhost otherwise)
NEXT_PUBLIC_DJANGO_BASE_URL=https://api.example.com
NEXT_PUBLIC_APP_NAME=Avocent Health Centre

# TLS / security hardening (Caddy terminates TLS in front of these services)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=avocent_healthcare
DB_USER=avocent
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

FRONTEND_URL=https://app.example.com
PASSWORD_RESET_TIMEOUT=86400

API_ENCRYPTION_ENABLED=true
API_ENCRYPTION_ENFORCE=true
API_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_WORKER_CONCURRENCY=4
CELERY_LOG_LEVEL=info
