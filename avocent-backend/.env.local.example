SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web

DB_ENGINE=django.db.backends.postgresql
DB_NAME=avocent_healthcare
DB_USER=avocent
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true

# Email / SMTP — local Mailpit mock mail server (https://mailpit.axllent.org)
# Run `mailpit`: SMTP on localhost:1025, captured mail UI at http://localhost:8025/
# EMAIL_CONFIGURED=true is required because Mailpit needs no credentials;
# leave it unset with a real SMTP host to gate sending on credentials instead.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_CONFIGURED=true
DEFAULT_FROM_EMAIL=noreply@avocent.health

# Frontend base URL, used to build links embedded in outgoing emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=86400

API_ENCRYPTION_ENABLED=false
API_ENCRYPTION_ENFORCE=false
API_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
CELERY_WORKER_CONCURRENCY=2
CELERY_LOG_LEVEL=info
