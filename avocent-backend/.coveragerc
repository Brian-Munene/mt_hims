[run]
branch = True
source = .
omit =
    manage.py
    */migrations/*
    */tests/*
    */test_*.py
    */.venv/*
    */avocent_backend/asgi.py
    */avocent_backend/wsgi.py
    */avocent_backend/celery.py

[report]
skip_empty = True
precision = 1
exclude_also =
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
