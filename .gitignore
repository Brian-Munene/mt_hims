# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/env/

# Django runtime artifacts
**/*.log
**/media/
**/staticfiles/
**/celerybeat-schedule

# Node / Next.js
**/node_modules/
**/.next/

# Secrets — keep the .example templates tracked, ignore the real files
**/.env.local
**/.env.staging
**/.env.prod

# App logs
**/logs/

# Editors / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
**/.DS_Store
Thumbs.db

# Test / coverage
**/.coverage
**/htmlcov/
**/.pytest_cache/

# Personal / business documents — not part of the codebase
/Documents/

# Claude Code project-local state — track agents + shared settings, ignore only personal overrides
/.claude/settings.local.json

# Terraform — provider caches, state, and local var files never belong in git
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/crash.log
